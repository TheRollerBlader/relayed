{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": [
      "ES2021",
      "dom"
    ],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/index.ts",
    "src/schema.ts",
    "src/logic.ts",
    "src/solver.ts"
  ]
}
